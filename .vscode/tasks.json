{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dwes: dev:all",
      "type": "shell",
      "command": "npm run dev:all",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dwes-dev"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "dwes: frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dwes-dev"
      }
    },
    {
      "label": "dwes: backend (Nest)",
      "type": "shell",
      "command": "npm run backend",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]

# DWES dev/demo environment — https://dwes.ingenious-network.com
# This is the template for the GitHub Secret `DWES_ENV_FILE` (the CI writes its full
# contents to infra/docker/.env on the VM at deploy time). NEVER commit real secrets.

# --- Public site (WebAuthn RP_ID/RP_ORIGIN/CORS must match the domain apex, HTTPS) ---
DWES_DOMAIN=dwes.ingenious-network.com
CORS_ORIGINS=https://dwes.ingenious-network.com
RP_ID=dwes.ingenious-network.com
RP_ORIGIN=https://dwes.ingenious-network.com
RP_NAME=DWES (Dev)

# --- Persistent data root on the VM (survives redeploys; holds postgres/uploads/auth/ssl) ---
# Use /opt/dwes-data on the boot disk, or /mnt/dwes-data if you attach a block volume.
DATA_ROOT=/opt/dwes-data

# --- PostgreSQL (container; restore the real DB into this on first deploy — see DEV-DEPLOY.md) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=WiringSchemeDB

# --- Auth ---
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Real-data mode (no demo seeds / no login hints). NOTE: with DEMO_MODE=false the app runs
# NODE_ENV=production, so Admin/Director are prompted on first login to rotate password +
# enroll WebAuthn (production bootstrap). That is expected. Ask if you want this relaxed for
# the review environment.
DEMO_MODE=false

# --- Host ports ---
HTTP_PORT=80
HTTPS_PORT=443

# DWES static frontend + Nginx reverse proxy
# Build context: repository root
#   docker build -f infra/docker/Dockerfile.nginx -t dwes-nginx .

FROM node:22-bookworm-slim AS fe-build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
RUN apk add --no-cache curl
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infra/nginx/conf.d/dwes.conf /etc/nginx/conf.d/default.conf
COPY infra/nginx/proxy_params.conf /etc/nginx/proxy_params.conf
# dwes.conf `include`s this snippet; without it `nginx -t` fails and the container won't start.
COPY infra/nginx/snippets/ /etc/nginx/snippets/
COPY --from=fe-build /app/dist /usr/share/nginx/html
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1/healthz || exit 1
EXPOSE 80 443

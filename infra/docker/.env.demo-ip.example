# DWES IP-only demo on OCI (no DNS / no Let's Encrypt)
# Copy to infra/docker/.env by deploy-demo-from-windows.ps1 -IpOnly
# Never commit real secrets.

DWES_DOMAIN=CHANGE_ME_PUBLIC_IP
CORS_ORIGINS=http://CHANGE_ME_PUBLIC_IP
RP_ID=CHANGE_ME_PUBLIC_IP
RP_ORIGIN=http://CHANGE_ME_PUBLIC_IP
RP_NAME=DWES

CERTBOT_EMAIL=dwes@ingenious-network.com

DATA_ROOT=/opt/dwes-data

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=WiringSchemeDB

JWT_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
DEMO_MODE=true

HTTP_PORT=80
HTTPS_PORT=443

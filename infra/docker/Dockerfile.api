# DWES NestJS API — production image (OCI / Docker Compose)
# Build context: repository root
#   docker build -f infra/docker/Dockerfile.api -t dwes-api .

FROM node:22-bookworm-slim AS be-deps
WORKDIR /app/backend
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY backend/package.json backend/package-lock.json ./
RUN npm ci

FROM be-deps AS be-build
COPY backend/ ./
# prisma.config.ts eagerly resolves env('DATABASE_URL'); neither `prisma generate` nor the
# `npm run build` script (which re-runs generate) connects to a DB, so a build-only placeholder
# satisfies the config without baking a real URL in. The real DATABASE_URL is injected at runtime.
RUN export DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder" \
  && npm run build

FROM node:22-bookworm-slim AS be-prod-deps
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-bookworm-slim AS api
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates gosu \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd -r dwes && useradd -r -g dwes -d /app -s /usr/sbin/nologin dwes
WORKDIR /app
ENV NODE_ENV=production
COPY --from=be-build /app/backend/dist ./dist
COPY --from=be-prod-deps /app/backend/node_modules ./node_modules
# Ship the Prisma client generated in be-build — the prod-deps stage runs `npm ci --omit=dev`
# and never runs `prisma generate`, so without this the runtime `new PrismaClient()` throws.
COPY --from=be-build /app/backend/node_modules/.prisma ./node_modules/.prisma
COPY --from=be-build /app/backend/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=be-build /app/backend/package.json ./package.json
COPY --from=be-build /app/backend/prisma ./prisma
RUN mkdir -p /app/uploads /app/data && chown -R dwes:dwes /app
COPY infra/docker/scripts/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh
# Container starts as root so the entrypoint can chown the bind-mounted volumes (host-owned)
# to the app user, then drops privileges to non-root `dwes` via gosu before running Node.
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/api/health || exit 1
ENTRYPOINT ["/usr/local/bin/api-entrypoint.sh"]
CMD ["node", "dist/main.js"]

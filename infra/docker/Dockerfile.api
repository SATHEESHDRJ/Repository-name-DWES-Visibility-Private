# DWES NestJS API — production image (OCI / Docker Compose)
# Build context: repository root
#   docker build -f infra/docker/Dockerfile.api -t dwes-api .

FROM node:22-bookworm-slim AS be-deps
WORKDIR /app/backend
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY backend/package.json backend/package-lock.json ./
RUN npm ci

FROM be-deps AS be-build
COPY backend/ ./
RUN npx prisma generate && npm run build

FROM node:22-bookworm-slim AS be-prod-deps
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-bookworm-slim AS api
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd -r dwes && useradd -r -g dwes -d /app -s /usr/sbin/nologin dwes
WORKDIR /app
ENV NODE_ENV=production
COPY --from=be-build /app/backend/dist ./dist
COPY --from=be-prod-deps /app/backend/node_modules ./node_modules
COPY --from=be-build /app/backend/package.json ./package.json
COPY --from=be-build /app/backend/prisma ./prisma
RUN mkdir -p /app/uploads /app/data && chown -R dwes:dwes /app
USER dwes
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/api/health || exit 1
CMD ["node", "dist/main.js"]

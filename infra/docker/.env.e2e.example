# E2E stack — copy to infra/docker/.env.e2e (never commit secrets)
DATA_ROOT=./.e2e-data
DWES_DOMAIN=localhost
CORS_ORIGINS=http://localhost:18080
RP_ID=localhost
RP_ORIGIN=http://localhost:18080
RP_NAME=DWES E2E
POSTGRES_USER=postgres
POSTGRES_PASSWORD=e2e_postgres_password_change_me
POSTGRES_DB=WiringSchemeDB
JWT_SECRET=e2e_jwt_secret_minimum_32_chars_long_xx
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
DEMO_MODE=true
HTTP_PORT=18080
HTTPS_PORT=18443
DWES_API_IMAGE=dwes-api:e2e
DWES_NGINX_IMAGE=dwes-nginx:e2e

# DWES OCI production environment — copy to infra/docker/.env (never commit secrets)
# Region: me-dubai-1 (UAE Dubai) — optimized for Sharjah + Chennai users

# --- Public site (WebAuthn: RP_ID, RP_ORIGIN, CORS_ORIGINS must match DWES_DOMAIN apex) ---
DWES_DOMAIN=dwes.example.com
CORS_ORIGINS=https://dwes.example.com
RP_ID=dwes.example.com
RP_ORIGIN=https://dwes.example.com
RP_NAME=DWES

# --- TLS / Let's Encrypt (HTTP-01) — admin email for cert-expiry notices; set at go-live ---
# Not a secret. Blank -> init-letsencrypt.sh falls back to admin@$DWES_DOMAIN.
CERTBOT_EMAIL=

# --- Block volume bind root (cloud-init creates subdirs on OCI VM) ---
DATA_ROOT=/mnt/dwes-data

# --- PostgreSQL (container on block volume; no schema migrations) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=WiringSchemeDB

# --- Auth (required in production) ---
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
DEMO_MODE=false

# --- Ports (host) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Images (set by CI/CD / OCIR on tag deploy) ---
# DWES_API_IMAGE=me-dubai-1.ocir.io/tenancy/dwes-api:latest
# DWES_NGINX_IMAGE=me-dubai-1.ocir.io/tenancy/dwes-nginx:latest

# --- OCI Object Storage backup (Instance Principal on VM) ---
# OCI_NAMESPACE=
# OCI_BUCKET=dwes-backups
# OCI_REGION=me-dubai-1

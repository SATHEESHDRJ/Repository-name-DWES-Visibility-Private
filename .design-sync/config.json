{
  "shape": "package",
  "pkg": "dwes",
  "globalName": "DWES",
  "cssEntry": ".design-sync/compiled.css",
  "readmeHeader": ".design-sync/conventions.md",
  "extraFonts": ["node_modules/material-symbols/rounded.css"],
  "provider": { "component": "ThemeProvider", "inner": { "component": "MemoryRouter" } },
  "overrides": {
    "Modal": { "cardMode": "single", "viewport": "640x460", "primaryStory": "ConfirmDialog" },
    "Toast": { "cardMode": "single", "viewport": "460x180", "primaryStory": "Warning" },
    "ButtonHintPopover": { "cardMode": "single", "viewport": "520x160", "primaryStory": "AnchoredHint" },
    "Button": { "cardMode": "column" },
    "SectionHeader": { "cardMode": "column" },
    "Skeleton": { "cardMode": "column" },
    "DataTable": { "cardMode": "column" },
    "DashboardShell": { "cardMode": "single", "viewport": "1024x720", "primaryStory": "TechnicianDashboard" },
    "CompletionReport": { "cardMode": "column" },
    "CableSchematic": { "cardMode": "column" },
    "ReportPreviewModal": { "cardMode": "single", "viewport": "720x760", "primaryStory": "Preview" }
  },
  "componentSrcMap": {
    "Badge": "src/components/Badge.tsx",
    "Modal": "src/components/Modal.tsx",
    "KpiCard": "src/components/ui/KpiCard.tsx",
    "SectionHeader": "src/components/ui/SectionHeader.tsx",
    "Toast": "src/components/ui/Toast.tsx",
    "ThemeToggle": "src/components/ui/ThemeToggle.tsx",
    "ButtonHintPopover": "src/components/ui/ButtonHintPopover.tsx",
    "OverflowActionMenu": "src/components/ui/OverflowActionMenu.tsx",
    "CompanyLogo": "src/components/ui/CompanyLogo.tsx",
    "DashboardShell": "src/components/ui/DashboardShell.tsx",
    "ProjectInfoCard": "src/components/ui/ProjectInfoCard.tsx",
    "CableSchematic": "src/components/ui/CableSchematic.tsx",
    "CompletionReport": "src/components/ui/CompletionReport.tsx",
    "ReportPreviewModal": "src/components/ui/ReportPreviewModal.tsx",
    "VerificationModal": "src/components/ui/VerificationModal.tsx",
    "Button": "src/components/ui/Button.tsx",
    "Card": "src/components/ui/Card.tsx",
    "DataTable": "src/components/ui/DataTable.tsx",
    "EmptyState": "src/components/ui/EmptyState.tsx",
    "Icon": "src/components/ui/Icon.tsx",
    "Input": "src/components/ui/Input.tsx",
    "Skeleton": "src/components/ui/Skeleton.tsx",
    "FormGroup": "src/components/ui/Form.tsx",
    "FormLabel": "src/components/ui/Form.tsx",
    "FormInput": "src/components/ui/Form.tsx",
    "FormSelect": "src/components/ui/Form.tsx",
    "FormTextarea": "src/components/ui/Form.tsx",
    "FormError": "src/components/ui/Form.tsx",
    "InputField": "src/components/ui/TabletFields.tsx",
    "ComboField": "src/components/ui/TabletFields.tsx",
    "SelectField": "src/components/ui/TabletFields.tsx"
  }
}

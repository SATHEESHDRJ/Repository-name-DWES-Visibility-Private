# Copy to deploy-secrets.local.env (git-ignored). NEVER commit the real file.
# Used by: node scripts/go-live.mjs

# --- Domain (Cloudflare DNS only — gray cloud / proxied=false) ---
DWES_DOMAIN=dwes.ingeniousnetwork.com
CERTBOT_EMAIL=ops@example.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- OCI Terraform ---
OCI_REGION=me-dubai-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxx
OCI_OBJECT_STORAGE_NAMESPACE=your_namespace
OCI_SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGWX+Fx1gmBGsikcLBabBS0rr46DtQuGsmHJ8PfahnDN dwes-oci-bastion"
OCI_BASTION_CLIENT_CIDR='["203.0.113.10/32"]'
OCI_ALERT_EMAIL=ops@example.com
TF_PROJECT_NAME=dwes-prod
TF_APP_OCPUS=2
TF_APP_MEMORY_GB=12
TF_DATA_VOLUME_GB=100

# --- OCI API (for Terraform + CLI; or rely on ~/.oci/config only) ---
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
# Path to API private key PEM, or inline via OCI_PRIVATE_KEY (not recommended in file)
OCI_API_KEY_FILE=%USERPROFILE%\.oci\oci_api_key.pem

# --- OCIR / GitHub Actions §D ---
OCI_OCIR_HOST=me-dubai-1.ocir.io
OCI_OCIR_NAMESPACE=
OCI_OCIR_USERNAME=tenancy/oracleidentitycloudservice/user@example.com
OCI_OCIR_AUTH_TOKEN=

# --- Bastion deploy SSH (private key file paths) ---
OCI_VM_SSH_KEY_FILE=%USERPROFILE%\.ssh\dwes_oci
OCI_BASTION_SSH_PUBLIC_KEY_FILE=%USERPROFILE%\.ssh\dwes_oci.pub

# --- Post-deploy smoke ---
DWES_SMOKE_USER=
DWES_SMOKE_PASS=

# --- Local DB cutover (Windows pg_dump source) ---
LOCAL_PG_HOST=localhost
LOCAL_PG_PORT=5432
LOCAL_PG_USER=postgres
LOCAL_PG_DB=WiringSchemeDB
LOCAL_PG_PASSWORD=postgres

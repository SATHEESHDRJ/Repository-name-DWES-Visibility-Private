# PostgreSQL connection
DATABASE_URL="postgresql://user:password@localhost:5432/WiringSchemeDB"

# Server bind (LAN: keep 0.0.0.0 so tablets can reach API via Vite proxy)
HOST=0.0.0.0
PORT=3001

# WebAuthn / passkeys — hostname + HTTPS required (never use a raw LAN IP as RP_ID)
# Local dev (npm run dev:https): localhost is fine.
# LAN tablets: use a stable hostname (default dwes.local) — see DEPLOY-LAN.md.
#
# RP_ID = hostname only (no port, no scheme). Must match the URL you open in the browser.
# RP_ORIGIN = full https:// URL(s); comma-separate multiple dev origins if needed.
#
RP_ID=localhost
RP_ORIGIN=https://localhost:5173,https://dwes.local:5173
RP_NAME=DWES

# Optional: override LAN hostname used by cert generation (default dwes.local)
# DWES_HOSTNAME=dwes.local

# Demo/dev helpers (technician DEV toolbar, demo users, reset-all). Must be false in production.
# Restart the backend after changing this value.
DEMO_MODE=true

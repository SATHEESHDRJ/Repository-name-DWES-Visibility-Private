# PostgreSQL connection
DATABASE_URL="postgresql://user:password@localhost:5432/WiringSchemeDB"

# Server bind (LAN: keep 0.0.0.0 so tablets can reach API via Vite proxy)
HOST=0.0.0.0
PORT=3001

# WebAuthn / passkeys — hostname + HTTPS required (never use a raw LAN IP as RP_ID)
# Local dev (npm run dev:https): localhost is fine.
# LAN tablets: use a stable hostname (default dwes.local) — see DEPLOY-LAN.md.
#
# RP_ID = hostname only (no port, no scheme). Must match the URL you open in the browser.
# RP_ORIGIN = full https:// URL(s); comma-separate multiple dev origins if needed.
#
RP_ID=localhost
RP_ORIGIN=https://localhost:5173,https://dwes.local:5173
RP_NAME=DWES

# Optional: override LAN hostname used by cert generation (default dwes.local)
# DWES_HOSTNAME=dwes.local

# Production / OCI (see infra/docker/.env.production.example)
# CORS_ORIGINS=https://dwes.example.com
# TRUST_PROXY=true
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES_DAYS=7
# NODE_ENV=production
# Restart the backend after changing this value.
DEMO_MODE=true

# Maximum multipart upload size in MB (1-1024). Engineering 3D sources commonly exceed 50 MB.
DWES_MAX_UPLOAD_MB=250

# Optional secure DWG/DXF browser-preview converter.
# The executable MUST be an absolute path. Arguments MUST be a JSON string array and include
# both {input} and {output}; DWES invokes it directly with shell=false in an isolated temp folder.
# The source DWG/DXF is always retained unchanged. If this is unset or conversion fails, the API
# reports preview.status="failed" and does not fabricate or expose an invalid preview.
# Example using an administrator-installed converter (arguments vary by product):
# DWES_CAD_PREVIEW_EXECUTABLE=C:\Program Files\CADConverter\cadconvert.exe
# DWES_CAD_PREVIEW_ARGS_JSON=["--input","{input}","--output","{output}","--format","pdf"]
# Allowed output format: pdf or svg (default pdf). SVG output is rejected if it contains scripts,
# event handlers, foreignObject, DOCTYPE, javascript URLs, or external HTTP/data HTML resources.
# DWES_CAD_PREVIEW_FORMAT=pdf
# Conversion timeout in milliseconds (1000-600000, default 60000).
# DWES_CAD_PREVIEW_TIMEOUT_MS=60000
# Maximum validated preview output size in MB (1-500, default 100).
# DWES_CAD_PREVIEW_MAX_MB=100

# Optional: allow POST /api/dev/hard-reset without DEMO_MODE (local testing only — never in production).
# ALLOW_DEV_HARD_RESET=true

# ── Redis (optional; PostgreSQL remains the source of truth either way) ────────────
# When unset, every Redis-backed feature below runs on its non-Redis fallback:
# BullMQ jobs execute inline, SSE falls back to PostgreSQL LISTEN/NOTIFY (or local-only
# on a single instance), the dashboard cache is process-local memory only, and
# idempotency/distributed locks are process-local. This is safe for a single backend
# instance. Set REDIS_URL to enable cross-instance BullMQ workers, SSE fan-out, shared
# dashboard caching, and distributed idempotency/locks for a multi-instance deployment.
# Never expose port 6379 publicly and never commit a Redis URL containing a password.
# REDIS_URL=redis://localhost:6379
#
# Per-subsystem kill switches (each defaults to enabled whenever REDIS_URL is set):
# DWES_ENABLE_BULLMQ=true        # BullMQ background job queue/worker
# DWES_ENABLE_REDIS_CACHE=true   # Dashboard summary cache + distributed lock backing store
# DWES_REDIS_EVENT_FANOUT=true   # Redis Pub/Sub for cross-instance SSE (falls back to DWES_PG_EVENT_FANOUT)
# DWES_PG_EVENT_FANOUT=true      # PostgreSQL LISTEN/NOTIFY SSE fan-out, used when Redis fan-out is off/unavailable
